# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (required)
MONGO_URI=

# Long random string used to sign JWTs (required)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Optional: how long a login token lasts (default 1d)
JWT_EXPIRES_IN=1d

# Email OTP (NOT used yet - will be used when the OTP step is implemented)
EMAIL_USER=
EMAIL_PASSWORD=
